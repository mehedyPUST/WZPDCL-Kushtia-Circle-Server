# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/load-management

# API server
PORT=5000
NODE_ENV=development

# Authentication secrets (use strong random values)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d
ADMIN_REGISTRATION_SECRET=replace-with-registration-secret

# Exact frontend origins, comma-separated
FRONTEND_URL=http://localhost:3000,https://your-frontend.vercel.app

# Optional AI generation (kept server-side only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
